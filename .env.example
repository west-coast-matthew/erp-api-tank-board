# Copy this file to .env and fill in real values for your environment.
# .env is gitignored and should never be committed.

DB_USERNAME=demo
DB_PASSWORD=sql
DB_URL=jdbc:mysql://localhost:3306/erp_demo
DB_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# 'update' on a first run creates the tank_board tables; 'none' afterwards.
DDL_AUTO=update

# Adds the demo shared tank boards to any facility that has none.
SEED_DEMO_TEMPLATES=true
